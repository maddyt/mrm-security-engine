# All optional: the portal runs with no configuration.

# ---- Supabase (recommended on Vercel) ----
# Persists the audit ledger. Without it the ledger lives in server memory, which on serverless
# hosting means entries can differ between requests. Run supabase/migrations/0001_mrm_ledger.sql
# once in the Supabase SQL editor. Use the secret (service_role) key; it is never sent to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Token signing ----
# Signing key for the demo identity provider's JWTs. Any long random string.
# Falls back to SUPABASE_SERVICE_ROLE_KEY, then to a fixed demo key.
MRM_JWT_SECRET=
